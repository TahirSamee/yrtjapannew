<script>
    // Get the modal and elements
    var modal = document.getElementById("videoModal");
    var modalVideo = document.getElementById("modalVideo");
    var videoSource = document.getElementById("videoSource");
    var modalInstance = new bootstrap.Modal(modal);

    // When clicking on a video thumbnail, open the modal
    document.querySelectorAll(".video-thumbnail").forEach(function (thumbnail) {
        thumbnail.addEventListener("click", function () {
            debugger
            var videoUrl = thumbnail.getAttribute("data-video");
            videoSource.setAttribute("src", videoUrl);  // Set video source
            modalInstance.show();  // Show modal using Bootstrap's modal API

            modalVideo.load();  // Load the video
            modalVideo.play();  // Play the video
        });
    });

    // Close the modal if clicked outside the video (you already have this)
    window.addEventListener("click", function (event) {
        if (event.target === modal) {
            modalInstance.hide();  // Hide the modal using Bootstrap's modal API
            modalVideo.pause();  // Pause video when closing
            modalVideo.currentTime = 0;  // Reset video to the beginning (optional)
            videoSource.setAttribute("src", "");  // Reset video source (optional but cleaner)
        }
    });
</script>