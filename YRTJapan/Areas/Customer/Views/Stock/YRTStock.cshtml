                            <img src="/car-images/nofoto.gif" class="d-block cardConImage" alt="@car.MARKA_NAME @car.MODEL_NAME @car.YEAR" style="object-fit:cover!important;background: #a9a9a92b;">
                        </a>
                        
                    }
                }


