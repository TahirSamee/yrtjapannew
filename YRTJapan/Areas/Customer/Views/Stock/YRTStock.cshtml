            @*   <a href='/Customer/Stock/Details?id=@car.ID'>
        <img src="@imageUrl" alt="Car Image" class="cardConImage">
        </a> *@
        
        </div>

        <div class="sec-2" style="width: 66%;">
            <div class="stockquantity d-flex justify-content-between">
                    
