@using YRTJapan.Core.Entities
@model Car

@{
    ViewData["Title"] = "Edit Car";
}

<style>
    .select2-container--default .select2-selection--single {
        height: 40px !important;
    }
</style>

<div style="margin-left:15px;margin-right:15px">
    <h2>Edit Stock</h2>

    <form asp-action="Edit" enctype="multipart/form-data" method="post">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="ID" />

        <div class="row">
            <div class="col-md-4 mb-2">
                <label>LOT</label>
                <input asp-for="LOT" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>AUCTION_TYPE</label>
                <input asp-for="AUCTION_TYPE" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>AUCTION_DATE</label>
                <input asp-for="AUCTION_DATE" type="date" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>AUCTION</label>
                <input asp-for="AUCTION" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>MARKA_ID</label>
                <input asp-for="MARKA_ID" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>MODEL_ID</label>
                <input asp-for="MODEL_ID" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>MARKA_NAME</label>
                <input asp-for="MARKA_NAME" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>MODEL_NAME</label>
                <input asp-for="MODEL_NAME" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>YEAR</label>
                <select asp-for="YEAR" class="form-control">
                    @for (int year = DateTime.Now.Year; year >= 1980; year--)
                    {
                        <option value="@year">@year</option>
                    }
                </select>
            </div>


            <div class="col-md-4 mb-2">
                <label>TOWN</label>
                <input asp-for="TOWN" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>ENG_V (cc)</label>
                <input asp-for="ENG_V" type="number" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>PW</label>
                <input asp-for="PW" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>KUZOV</label>
                <input asp-for="KUZOV" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>GRADE</label>
                <input asp-for="GRADE" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>COLOR</label>
                <input asp-for="COLOR" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>KPP</label>
                <input asp-for="KPP" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>KPP_TYPE</label>
                <input asp-for="KPP_TYPE" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>PRIV</label>
                <input asp-for="PRIV" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>MILEAGE (km)</label>
                <input asp-for="MILEAGE" type="number" min="0" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>EQUIP</label>
                <input asp-for="EQUIP" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>RATE</label>
                <input asp-for="RATE" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>START Price</label>
                <input asp-for="START" type="number" step="any" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>FINISH Price</label>
                <input asp-for="FINISH" type="number" step="any" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>STATUS</label>
                <input asp-for="STATUS" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>TIME</label>
                <input asp-for="TIME" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>AVG_PRICE</label>
                <input asp-for="AVG_PRICE" type="number" step="any" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>AVG_STRING</label>
                <input asp-for="AVG_STRING" class="form-control" />
            </div>

            <div class="col-md-4 mb-2" hidden>
                <label>IMAGES (comma-separated)</label>
                <textarea asp-for="IMAGES" class="form-control" rows="2"></textarea>
            </div>

            <div class="col-md-4 mb-2">
                <label>TAG2</label>
                <input asp-for="TAG2" class="form-control" />
            </div>
            <div class="col-md-12 mb-3">
                <label>Existing Images</label>
                <div class="row">
                    @if (Model.carImages != null && Model.carImages.Any())
                    {
                        foreach (var img in Model.carImages)
                        {
                            <div class="col-md-3 text-center mb-2">
                                <img src="@img.ImageUrl" class="img-thumbnail" style="height: 120px;" />
                                <div>
                                    <input type="checkbox" name="deleteImages" value="@img.ImageUrl" /> Remove
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="col-md-12 text-muted">No images uploaded.</div>
                    }
                </div>
            </div>

            <div class="col-md-4 mb-2">
                <label>Upload Images</label>
                <input type="file" name="files" class="form-control" multiple />
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-3">Update</button>
        <a asp-action="Index" class="btn btn-secondary mt-3">Back</a>
    </form>
</div>
