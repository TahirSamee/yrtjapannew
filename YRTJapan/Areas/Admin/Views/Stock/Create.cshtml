@using YRTJapan.Core.Entities
@model Car
@{
    ViewData["Title"] = "Add New Car";
}

<style>
    .hide-field {
        display: none !important;
    }
</style>

<div style="margin-left:15px;margin-right:15px">
    <h2>Add Stock</h2>

    <form asp-action="Create" enctype="multipart/form-data" method="post">
        <div class="row">

            <!-- HIDDEN FIELDS -->
            <div class="col-md-4 mb-2 hide-field">
                <label>LOT</label>
                <input asp-for="LOT" class="form-control" />
            </div>

            <div class="col-md-4 mb-2 hide-field">
                <label>AUCTION_TYPE</label>
                <input asp-for="AUCTION_TYPE" class="form-control" />
            </div>

            <div class="col-md-4 mb-2 hide-field">
                <label>AUCTION_DATE</label>
                <input asp-for="AUCTION_DATE" type="date" class="form-control" />
            </div>

            <div class="col-md-4 mb-2 hide-field">
                <label>AUCTION</label>
                <input asp-for="AUCTION" class="form-control" />
            </div>

           

            <!-- VISIBLE REQUIRED FIELDS -->
            <div class="col-md-4 mb-2">
                <label>Marka Name</label>
                <input asp-for="MARKA_NAME" class="form-control" required />
            </div>

            <div class="col-md-4 mb-2">
                <label>Model Name</label>
                <input asp-for="MODEL_NAME" class="form-control" required />
            </div>

            <div class="col-md-4 mb-2">
                <label>Year</label>
                <select asp-for="YEAR" class="form-control" required>
                    @{
                        for (int year = DateTime.Now.Year; year >= 1980; year--)
                        {
                            <option value="@year">@year</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-4 mb-2">
                <label>Model Code</label>
                <input asp-for="MARKA_ID" class="form-control" />
            </div>

            <div class="col-md-4 mb-2">
                <label>Chassis</label>
                <input asp-for="MODEL_ID" class="form-control" />
            </div>
            <div class="col-md-4 mb-2">
                <label>Engine CC</label>
                <input asp-for="ENG_V" type="number" class="form-control"  />
            </div>

            <div class="col-md-4 mb-2">
                <label>Grade</label>
                <input asp-for="GRADE" class="form-control"  />
            </div>

            <div class="col-md-4 mb-2">
                <label>Color</label>
                <input asp-for="COLOR" class="form-control"  />
            </div>

            <div class="col-md-4 mb-2">
                <label>Mileage</label>
                <input asp-for="MILEAGE" type="number" class="form-control"  />
            </div>

            <div class="col-md-4 mb-2">
                <label>FOB Price</label>
                <input asp-for="START" type="number" class="form-control"  />
            </div>

            <div class="col-md-4 mb-2">
                <label>Total Price</label>
                <input asp-for="FINISH" type="number" class="form-control"  />
            </div>

            <div class="col-md-12 mb-2">
                <label>Other Selling Points</label>
                <textarea asp-for="EQUIP" class="form-control" rows="3"></textarea>
            </div>

            <!-- Upload images should be visible -->
            <div class="col-md-12 mb-2">
                <label>Upload Images</label>
                <input type="file" name="files" class="" multiple required />
            </div>

            <!-- HIDDEN FIELDS CONTINUED -->
            <div class="col-md-4 mb-2 hide-field">
                <label>PW</label>
                <input asp-for="PW" class="form-control" />
            </div>

            <div class="col-md-4 mb-2 hide-field">
                <label>KUZOV</label>
                <input asp-for="KUZOV" class="form-control" />
            </div>

            <div class="col-md-4 mb-2 hide-field">
                <label>KPP</label>
                <input asp-for="KPP" class="form-control" />
            </div>

            <div class="col-md-4 mb-2 hide-field">
                <label>KPP_TYPE</label>
                <input asp-for="KPP_TYPE" class="form-control" />
            </div>

            <div class="col-md-4 mb-2 hide-field">
                <label>PRIV</label>
                <input asp-for="PRIV" class="form-control" />
            </div>

            <div class="col-md-4 mb-2 hide-field">
                <label>RATE</label>
                <input asp-for="RATE" class="form-control" />
            </div>

            <div class="col-md-4 mb-2 hide-field">
                <label>STATUS</label>
                <input asp-for="STATUS" class="form-control" />
            </div>

            <div class="col-md-4 mb-2 hide-field">
                <label>TIME</label>
                <input asp-for="TIME" class="form-control" />
            </div>

            <div class="col-md-4 mb-2 hide-field">
                <label>AVG_PRICE</label>
                <input asp-for="AVG_PRICE" class="form-control" />
            </div>

            <div class="col-md-4 mb-2 hide-field">
                <label>AVG_STRING</label>
                <input asp-for="AVG_STRING" class="form-control" />
            </div>

            <div class="col-md-4 mb-2 hide-field">
                <label>TAG2</label>
                <input asp-for="TAG2" class="form-control" />
            </div>

        </div>

        <button type="submit" class="btn btn-primary mt-3">Save</button>
        <a asp-action="Index" class="btn btn-secondary mt-3">Back</a>
    </form>
</div>
